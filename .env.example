# Copy this file to .env and fill in real values before running the app.

# Flask
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# Database — leave unset to use a local SQLite file at instance/reelo.db,
# or point this at Postgres/MySQL etc. for production, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/reelo
# DATABASE_URL=sqlite:////absolute/path/to/instance/reelo.db
